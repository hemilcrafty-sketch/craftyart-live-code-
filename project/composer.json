{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.0",
        "ext-json": "*",
        "ext-openssl": "*",
        "aws/aws-sdk-php": "^3.228",
        "beyondcode/laravel-websockets": "^2.0@beta",
        "dompdf/dompdf": "^2.0",
        "fideloper/proxy": "^4.4",
        "firebase/php-jwt": "^6.10",
        "fruitcake/laravel-cors": "^2.0",
        "google/auth": "^1.41",
        "google/cloud-storage": "^1.46",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^2.7",
        "jenssegers/agent": "^2.6",
        "kreait/firebase-php": "^7.14",
        "ladumor/one-signal": "^0.4.3",
        "laravel/framework": "^8.12",
        "laravel/sanctum": "^2.15",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^3.2",
        "league/flysystem-aws-s3-v3": "^1.0",
        "maatwebsite/excel": "^3.1",
        "php-ffmpeg/php-ffmpeg": "^1.2",
        "razorpay/razorpay": "2.9",
        "smalot/pdfparser": "^2.1",
        "soarecostin/file-vault": "^1.2",
        "spatie/async": "^1.5",
        "spatie/image": "^1.10",
        "spatie/laravel-google-cloud-storage": "^1.1",
        "stripe/stripe-php": "^13.7"
    },
    "require-dev": {
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
